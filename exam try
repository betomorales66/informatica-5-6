def main():
    binary = input("Enter a binary number: ")
    binary_to_decimal(binary)


def binary_to_decimal(binary):
    invalid_count = 0

    # Count how many invalid characters exist
    for digit in binary:
        if digit not in ["0", "1"]:
            invalid_count = invalid_count + 1

    if invalid_count == 0:
        decimal = 0
        reversed_binary = binary[::-1]

        # Add up positional values using index power
        for i in range(len(reversed_binary)):
            if reversed_binary[i] == "1":
                decimal = decimal + (2**i)

        print(f"Decimal equivalent: {decimal}")
    else:
        print("Invalid input! Only 0s and 1s allowed.")


if __name__ == "__main__":
    main()